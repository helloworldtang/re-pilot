{"requirement": "匹配车牌号，如粤B12345。", "regex": "^[京津沪粤苏浙][A-Z][A-Z0-9]{5}$", "flags": "", "positive": ["京D5A7B2", "粤BB8A49", "苏G776B9"], "negative": ["A12345", "京12345", "京A1234", "沪A-12345"]}
